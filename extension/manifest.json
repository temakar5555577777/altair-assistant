{
  "manifest_version": 3,
  "name": "Altair Assistant — браузер",
  "short_name": "Altair",
  "description": "Даёт ИИ-агенту Altair видеть элементы страницы и нажимать точно. Работает только с программой Altair на этом компьютере.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "Altair Assistant", "default_popup": "popup.html" }
}
